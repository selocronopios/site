meta {
  name: Upload midia
  type: http
  seq: 1
}

post {
  url: {{url}}/api/media/upload
  body: multipartForm
  auth: none
}

headers {
  Content-Type: multipart/form-data
  User-Agent: insomnia/11.2.0
}

body:multipart-form {
  bucket: privado
  folder: convers
