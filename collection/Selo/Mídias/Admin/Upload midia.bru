meta {
  name: Upload midia
  type: http
  seq: 1
}

post {
  url: {{url}}/media/upload
  body: multipartForm
  auth: bearer
}

headers {
  Content-Type: multipart/form-data
  User-Agent: insomnia/11.2.0
}

auth:bearer {
  token: {{auth}}
}

body:multipart-form {
  bucket: privado
  folder: convers
  file: @file(/home/bia/Documentos/site/tests/testfile.pdf)
}

script:post-response {
  bru.setEnvVar("media", res.body.id)
}
