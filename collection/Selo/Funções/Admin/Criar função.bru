meta {
  name: Criar função
  type: http
  seq: 1
}

post {
  url: {{url}}/functions
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  User-Agent: insomnia/11.2.0
}

auth:bearer {
  token: {{auth}}
}

body:json {
  {
    "description":"Função da Louca7",
    "group_type":1
  }
}

script:post-response {
  bru.setEnvVar("function", res.body[0].id)
}
