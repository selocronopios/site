meta {
  name: Criar ebook
  type: http
  seq: 1
}

post {
  url: {{url}}/ebooks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth}}
}

body:json {
  {
    "title":"Ebook X",
    "subtitle":"subtitle X",
    "authors":"authors X",
    "authorship":"authorship X",
    "summary":"summary X",
    "year":2025,
    "description":"Description X",
    "file_id":"0c4a018a-e5ed-441b-8997-bffb1a6150fa",
    "cover_id":"33908216-42cf-4d89-b54f-6d8ac37c3542",
    "collection_id":"f99c7f5a-b4bd-4d06-b9cf-8c97fd0223c6",
    "keywords":"Itinerários da História Intelectual",
    "publisher": "UFMG",
    "edition": 1,
    "pages": 150,
    "format": "PDF",
    "isbn":"111-11-11111-11-11-3"
  }
}

script:post-response {
  bru.setEnvVar("ebook", res.body[0].id)
}
