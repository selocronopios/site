meta {
  name: Criar ebook
  type: http
  seq: 1
}

post {
  url: {{url}}/ebooks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth}}
}

body:json {
  {
    "title":"Ebook da Carol 2",
    "subtitle":"subtitle 2",
    "authors":"authors 2",
    "authorship":"authorship 2",
    "summary":"summary 2",
    "details":"details 2",
    "year":2024,
    "description":"description 2",
    "file_id":"fb3679f7-611a-42a2-be13-6c7cb88cd425",
    "cover_id":"fb3679f7-611a-42a2-be13-6c7cb88cd425",
    "link":null,
    "collection_id":"99522df7-5370-4fa3-a325-6f63d41a1b8d",
    "keywords":"keywords 2"
  }
}

script:post-response {
  bru.setEnvVar("ebook", res.body[0].id)
}
