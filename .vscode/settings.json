{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "eslint.enable": true,
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "typescript",
    "typescriptreact",
    "javascriptreact"
  ],
  "css.validate": false,
  "tailwindCSS.includeLanguages": {
    "css": "css",
    "plaintext": "html",
    "javascript": "javascript",
    "typescript": "typescript",
    "typescriptreact": "typescriptreact"
  }
}
